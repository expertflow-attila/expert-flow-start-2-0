---
interface Props {
  slug: string;
  num?: string;
  title: string;
  summary: string;
  tag: string;
  tagKind: "intro" | "epito" | "bonus";
  phaseLabel: string;
  /** Force the blue "support track" tag (checkpoints, reference library). */
  accent2?: boolean;
}
const { slug, num, title, summary, tag, tagKind, phaseLabel, accent2 = false } = Astro.props;

const tagClass =
  tagKind === "bonus" ? "cat-tag bonus" : accent2 ? "cat-tag cat-tag--blue" : "cat-tag";
const url = `/modules/${slug}`;
---

<a class="card" href={url}>
  <span class={tagClass}>{tag}</span>
  <h3>{title}</h3>
  <p>{summary}</p>
  <div class="meta">
    <span class="reveal"><span class="arr">→</span> Olvasás</span>
  </div>
</a>
