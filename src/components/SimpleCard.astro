---
interface Props {
  slug: string;
  num?: string;
  title: string;
  summary: string;
  tag: string;
  tagKind: "intro" | "epito" | "bonus";
  phaseLabel: string;
}
const { slug, num, title, summary, tag, tagKind, phaseLabel } = Astro.props;

const tagClass = tagKind === "bonus" ? "cat-tag bonus" : "cat-tag";
const url = `/modules/${slug}`;
---

<a class="card" href={url}>
  <span class={tagClass}>{tag}</span>
  <h3>
    {num && <span class="module-num">{num}</span>}{title}
  </h3>
  <p>{summary}</p>
  <div class="meta">
    <span>{phaseLabel}</span>
    <span class="reveal"><span class="arr">→</span> Olvasás</span>
  </div>
</a>
