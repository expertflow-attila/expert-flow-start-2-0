---
// Expert Flow ökoszisztéma — cross-link a többi 6 site-ra
// (a saját Business Start site-ot kihagyjuk a listából)

const sites = [
  {
    href: "https://expert-flow-school.vercel.app",
    title: "Expert Flow Library",
    note: "Tananyagok egy helyen",
  },
  {
    href: "https://learning-agents-landing.vercel.app",
    title: "Learning Agents",
    note: "AI karakterek oktatáshoz",
  },
  {
    href: "https://funnel-tananyag.vercel.app",
    title: "Funnel Tananyag",
    note: "Funnel-típusok és wireframe-ek",
  },
  {
    href: "https://copywriting-ef.vercel.app",
    title: "Copywriting",
    note: "Magyar copywriting tananyag",
  },
  {
    href: "https://marketing-skiccfuzet.vercel.app",
    title: "Marketing Skiccfüzet",
    note: "Weboldal- és funnel-vázlatok",
  },
  {
    href: "https://esettanulmanyok-ef.vercel.app",
    title: "Esettanulmányok",
    note: "Nemzetközi szakértő-bontások",
  },
];
---

<section class="ecosystem-footer" aria-labelledby="ecosystem-heading">
  <div class="ecosystem-inner">
    <p class="ecosystem-eyebrow">Expert Flow ökoszisztéma</p>
    <h3 id="ecosystem-heading">Tanulj a többi <em>anyagból</em> is</h3>
    <ul class="ecosystem-grid">
      {sites.map((s) => (
        <li>
          <a href={s.href} rel="noopener">
            <span class="ecosystem-card__title">{s.title}</span>
            <span class="ecosystem-card__note">{s.note}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
