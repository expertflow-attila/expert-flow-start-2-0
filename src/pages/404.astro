---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 — Business Start"
  description="Ezt az oldalt nem találom. Térj vissza a tartalomjegyzékhez."
  noindex={true}
>

  <header class="hero">
    <div class="eyebrow">404 — Nincs ilyen oldal</div>
    <h1>Ezt az oldalt <em>nem találom</em></h1>
    <p class="lede">
      Lehet, hogy átköltöztettem, vagy elírtad a linket.
      Innen visszatérhetsz a tartalomjegyzékhez, vagy átnézheted a diasorokat
      és a glosszáriumot.
    </p>
    <div class="hero-ctas">
      <a href="/" class="hero-cta">
        Tartalomjegyzék <span class="arrow">→</span>
      </a>
      <a href="/decks" class="hero-cta hero-cta--ghost">
        Diasorok <span class="arrow">→</span>
      </a>
      <a href="/glosszarium" class="hero-cta hero-cta--ghost">
        Glosszárium <span class="arrow">→</span>
      </a>
    </div>
  </header>

</Layout>
