---
import Layout from "../../layouts/Layout.astro";
import order from "../../data/order.json";
import modulesData from "../../data/modules.json";
import casesData from "../../data/case-studies.json";
import moduleLinks from "../../data/module-links.json";
import moduleDownloads from "../../data/module-downloads.json";

interface OrderItem {
  slug: string;
  title: string;
  summary: string;
  breadcrumb: string;
  kind: "intro" | "epito" | "ref" | "bonus";
  phaseLabel: string;
  moduleId?: string;
}

interface ModuleData {
  id: string;
  slug: string;
  promptIntro: string;
  promptText: string;
  caseStudyIds: string[];
  result?: string;
  lessons?: string[];
}

interface CaseStudy { id: string; name: string; category: string; note: string; }

export async function getStaticPaths() {
  const all = import.meta.glob("../../content/modules/*.md", { eager: true });
  const items = order as OrderItem[];
  return items.map((m, idx) => ({
    params: { slug: m.slug },
    props: {
      meta: m,
      idx,
      prev: idx > 0 ? items[idx - 1] : null,
      next: idx < items.length - 1 ? items[idx + 1] : null,
      content: all[`../../content/modules/${m.slug}.md`],
    },
  }));
}

const { meta, prev, next, content } = Astro.props as {
  meta: OrderItem;
  prev: OrderItem | null;
  next: OrderItem | null;
  content: any;
};

const Content = content?.Content;
const moduleData = meta.moduleId
  ? (modulesData as ModuleData[]).find((m) => m.id === meta.moduleId)
  : null;

const linkedCases: CaseStudy[] = moduleData?.caseStudyIds
  ? moduleData.caseStudyIds
      .map((id) => (casesData as CaseStudy[]).find((c) => c.id === id))
      .filter((c): c is CaseStudy => Boolean(c))
  : [];

const downloadBase = `/downloads/${meta.slug}`;

const linksData = (moduleLinks as Record<string, { title: string; links: { label: string; url: string }[] }>)[meta.slug];
const linksTitle = linksData?.title ?? "Hasznos linkek";
const links = linksData?.links ?? [];

const downloads = ((moduleDownloads as Record<string, { label: string; file: string }[]>)[meta.slug]) ?? [];

const site = (Astro.site ?? new URL("https://expert-flow-start-2-0.vercel.app")).toString();
const moduleUrl = `${site}modules/${meta.slug}`;

const learningResource = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: meta.title,
  description: meta.summary,
  url: moduleUrl,
  inLanguage: "hu",
  educationalLevel: "Beginner",
  learningResourceType:
    meta.kind === "ref"
      ? "Reference library"
      : meta.kind === "bonus"
      ? "Bonus module"
      : meta.kind === "intro"
      ? "Course intro"
      : "Online module",
  timeRequired: meta.kind === "epito" ? "PT3H" : "PT1H",
  isPartOf: {
    "@type": "Course",
    name: "Business Start",
    url: site,
  },
  isAccessibleForFree: true,
  inDefinedTermSet: meta.phaseLabel,
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Főoldal", item: site },
    { "@type": "ListItem", position: 2, name: meta.phaseLabel, item: `${site}#modulok` },
    { "@type": "ListItem", position: 3, name: meta.title, item: moduleUrl },
  ],
};

const moduleSchemas = [learningResource, breadcrumbs];

// SEO title ≤60 karakter: a " — Business Start" utótagot csak akkor tesszük ki,
// ha belefér; hosszú modul-címeknél a tiszta cím megy ki.
const fullTitle = `${meta.title} — Business Start`;
const seoTitle = fullTitle.length <= 60 ? fullTitle : meta.title;

// Meta description ≤160 karakter — szóhatáron vágva, ha kell.
const rawDesc = meta.summary ?? "";
const metaDescription =
  rawDesc.length <= 160
    ? rawDesc
    : rawDesc.slice(0, 157).replace(/\s+\S*$/, "") + "…";
---

<Layout
  title={seoTitle}
  description={metaDescription}
  schema={moduleSchemas}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="hu" href={moduleUrl} />
    <link rel="alternate" hreflang="x-default" href={moduleUrl} />
  </Fragment>

  <header class="lesson-header">
    <div class="container">
      <a href="/" class="back"><span class="arr">←</span> Főoldal</a>
      <h1>{meta.title}</h1>
      <p class="summary">{meta.summary}</p>
    </div>
  </header>

  <div class="video-block">
    <div class="video-cover" role="img" aria-label="Modul videó (hamarosan)">
      <div class="play-btn" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
      </div>
      <span class="meta-tag">PLAY · hamarosan</span>
    </div>
  </div>

  <article class="lesson-body">
    {Content ? <Content /> : <p>A modul tartalma hamarosan elérhető.</p>}
  </article>

  <div class="toolkit">
    <div class="toolkit-header">
      <span class="toolkit-eyebrow">A modul munkaeszközei</span>
      <h2>Eszközök, prompt és források</h2>
    </div>
    <div class="toolkit-grid">

      {downloads.length > 0 ? (
        <article class="toolkit-card">
          <span class="icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </span>
          <h3>Letölthető anyagok</h3>
          <p class="tk-desc">A modul munkafájljai — másold a saját projekt-mappádba.</p>
          <ul class="gh-list">
            {downloads.map((d) => (
              <li><a href={`${downloadBase}/${d.file}`} download><span>{d.label}</span><span class="gh-arrow">↓</span></a></li>
            ))}
          </ul>
        </article>
      ) : (
        <article class="toolkit-card">
          <span class="icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
          </span>
          <h3>Tár-anyag</h3>
          <p class="tk-desc">{meta.kind === "ref" ? "Referencia-tár — bármikor visszanyúlhatsz hozzá, amikor új mintára van szükséged. A teljes tartalom a fenti olvasható szöveg." : meta.kind === "bonus" ? "Bónusz tár — a 12 hét után érdemes megnyitni, amikor továbblépnél a skálázódás felé." : "Bevezető és záró anyag — a kurzus keretrendszere."}</p>
          <div class="tk-action">
            <span class="btn" style="opacity: 0.55; cursor: default;">Olvasható oldalon</span>
          </div>
        </article>
      )}

      {moduleData?.promptText ? (
        <article class="toolkit-card">
          <span class="icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </span>
          <h3>Prompt másolása</h3>
          <p class="tk-desc">{moduleData.promptIntro}</p>
          <pre id={`prompt-${meta.slug}`} class="prompt-text">{moduleData.promptText}</pre>
          <div class="tk-action">
            <button type="button" class="btn" data-copy-target={`#prompt-${meta.slug}`} data-label="Másol">Másol</button>
          </div>
        </article>
      ) : (
        <article class="toolkit-card">
          <span class="icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
          </span>
          <h3>Hogyan használd</h3>
          <p class="tk-desc">{meta.kind === "ref" ? "Referencia-tár — bármikor visszanyúlhatsz hozzá, amikor új mintára van szükséged. A teljes tartalom a fenti olvasható szövegben." : meta.kind === "bonus" ? "Bónusz tár — a 12 hét után érdemes megnyitni, amikor a skálázódás felé továbblépnél." : "Bevezető és záró anyag — a kurzus keretrendszere és lezárása."}</p>
          <div class="tk-action">
            <span class="btn" style="opacity: 0.55; cursor: default;">A szövegben olvasható</span>
          </div>
        </article>
      )}

      <article class="toolkit-card" id="linkek">
        <span class="icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 14L21 3"/>
            <path d="M21 3v7"/>
            <path d="M21 3h-7"/>
            <path d="M19 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h6"/>
          </svg>
        </span>
        <h3>{linksTitle}</h3>
        {links.length > 0 ? (
          <ul class="gh-list">
            {links.map((g) => (
              <li><a href={g.url} target="_blank" rel="noopener noreferrer"><span>{g.label}</span><span class="gh-arrow">↗</span></a></li>
            ))}
          </ul>
        ) : (
          <p class="tk-desc">A modulhoz külön linkek nincsenek megadva.</p>
        )}
      </article>

    </div>
  </div>

  <nav class="pager" aria-label="Modul navigáció">
    <div class="pager-grid">
      {prev ? (
        <a href={`/modules/${prev.slug}`} class="prev">
          <span class="label">← Előző</span>
          <span class="title">{prev.title}</span>
        </a>
      ) : <span class="pager-spacer"></span>}
      {next ? (
        <a href={`/modules/${next.slug}`} class="next">
          <span class="label">Következő →</span>
          <span class="title">{next.title}</span>
        </a>
      ) : <span class="pager-spacer"></span>}
    </div>
  </nav>

</Layout>
