---
import Layout from "../layouts/Layout.astro";
import Module from "../components/Module.astro";
import SimpleCard from "../components/SimpleCard.astro";
import modulesData from "../data/modules.json";
import extraData from "../data/extra-modules.json";

interface ModuleData {
  id: string;
  slug: string;
  phase: string;
  phaseShort: string;
  title: string;
  summary: string;
  result: string;
  lessons: string[];
  promptIntro: string;
  promptText: string;
  caseStudyIds: string[];
}

interface ExtraModule {
  id: string;
  slug: string;
  num?: string;
  title: string;
  summary: string;
  tag: string;
  tagKind: "intro" | "epito" | "bonus";
  phaseLabel: string;
}

const modules: ModuleData[] = modulesData;
const extras: ExtraModule[] = extraData;

const intro = extras.find((e) => e.id === "intro")!;
const outro = extras.find((e) => e.id === "outro")!;
const refs = extras.filter((e) => ["17", "18", "19"].includes(e.id));
const bonuses = extras.filter((e) => ["20", "21", "22", "23"].includes(e.id));

const phases = [
  { num: "I. fázis", title: "Mit adsz el és kinek?", weeks: "1-3. hét", ids: ["01", "02", "03"] },
  { num: "II. fázis", title: "Hogyan találjanak meg?", weeks: "4-6. hét", ids: ["04", "05", "06"] },
  { num: "III. fázis", title: "Hogyan szólítsd meg őket?", weeks: "7-9. hét", ids: ["07", "08", "09"] },
  { num: "IV. fázis", title: "Háttér és számok", weeks: "10-12. hét", ids: ["10", "11", "12"] },
];

const site = (Astro.site ?? new URL("https://expert-flow-start-2-0.vercel.app")).toString();

const allLearning = [
  ...modules.map((m) => ({
    "@type": "LearningResource",
    name: m.title,
    description: m.summary,
    url: `${site}modules/${m.id}-${m.slug}`,
    learningResourceType: "Online module",
    inLanguage: "hu",
  })),
  ...extras.map((e) => ({
    "@type": "LearningResource",
    name: e.title,
    description: e.summary,
    url: `${site}modules/${e.slug}`,
    learningResourceType:
      e.id === "intro" || e.id === "outro"
        ? "Course overview"
        : e.tagKind === "bonus"
          ? "Bonus module"
          : "Reference library",
    inLanguage: "hu",
  })),
];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Solo Business",
  url: "https://expertflow.hu",
  email: "hello@expertflow.hu",
  logo: `${site}favicon.svg`,
  description: "Egyéni vállalkozóknak szóló AI-asszisztált online tananyagok és kurzusok.",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Business Start",
  url: site,
  inLanguage: "hu",
  publisher: { "@type": "Organization", name: "Solo Business", url: "https://expertflow.hu" },
};

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Business Start — 12 hét, ahogy én építem fel a vállalkozásomat",
  description: "Egyéni vállalkozóknak — a kiindulóponttól egy működő, AI-asszisztált online vállalkozásig — minden modulhoz másolható diasorral. A kurzus végére van weboldalad, lead magneted, konzultációs funneled, CRM-ed, és egy működő AI Operációs Rendszered.",
  inLanguage: "hu",
  url: site,
  provider: {
    "@type": "Organization",
    name: "Solo Business",
    url: "https://expertflow.hu",
    email: "hello@expertflow.hu",
  },
  educationalLevel: "Beginner",
  audience: {
    "@type": "EducationalAudience",
    educationalRole: "self-employed entrepreneur",
  },
  teaches: [
    "AI-asszisztált online vállalkozásépítés",
    "Weboldal és landing oldal készítése",
    "Lead magnet és email lista",
    "Konzultációs funnel",
    "CRM és háttérautomatizáció",
  ],
  isAccessibleForFree: true,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "HUF",
    availability: "https://schema.org/InStock",
  },
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "online",
    courseWorkload: "PT24H",
    inLanguage: "hu",
  },
  numberOfCredits: 21,
  hasPart: allLearning,
};
---

<Layout
  title="Business Start — 12 hét, ahogy felépítem a vállalkozásom"
  description="Egyéni vállalkozóknak — a kiindulóponttól egy működő, AI-asszisztált online vállalkozásig. A kurzus végére van weboldalad, lead magneted, konzultációs funneled, CRM-ed, és egy működő AI Operációs Rendszered."
  schema={[courseSchema, websiteSchema, organizationSchema]}
>

  <header class="hero">
    <div class="eyebrow">Online kurzus · 12 hét</div>
    <h1>Business <em>Start</em></h1>
    <p class="lede">
      Egyéni vállalkozóknak — a kiindulóponttól egy működő,
      AI-asszisztált online vállalkozásig. Saját kezűleg, dokumentáló hangon.
    </p>
  </header>

  <section class="anti" aria-labelledby="anti-heading">
    <div class="anti__inner">
      <div class="section-head">
        <span class="eyebrow">Elhatárolás</span>
        <h2 id="anti-heading">Mi <em>NEM</em> ez?</h2>
        <span class="meta">döntsd el 30 másodperc alatt</span>
      </div>
      <div class="anti__grid">
        <div class="anti__col anti__col--no">
          <h3>Nem <em>ez</em></h3>
          <ul>
            <li>Általános AI-tanfolyam (ChatGPT/Claude API-kódolás)</li>
            <li>n8n / Zapier automatizáció-kurzus</li>
            <li>E-kereskedelem üzlet-indítás</li>
            <li>Ügynöki üzletág / arbitrázs-modell</li>
          </ul>
        </div>
        <div class="anti__col anti__col--yes">
          <h3>Hanem <em>ez</em></h3>
          <ul>
            <li>Egyéni vállalkozónak (coach, tanácsadó, ügyvéd, könyvelő)</li>
            <li>Strukturált út a kezdettől az első ügyfélig</li>
            <li>Magyar piacra szabva (NAV, ÁFA, KATA, EV, Kft.)</li>
            <li>Dokumentáló hang, nem tanácsadó</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="container" id="modulok">
    <section class="phase-section">
      <div class="phase-header">
        <span class="phase-title">Bevezető</span>
        <span class="phase-meta">kezdés</span>
      </div>
      <div class="grid">
        <SimpleCard
          slug={intro.slug}
          title={intro.title}
          summary={intro.summary}
          tag={intro.tag}
          tagKind={intro.tagKind}
          phaseLabel={intro.phaseLabel}
        />
      </div>
    </section>

    {phases.map((phase) => (
      <section class="phase-section">
        <div class="phase-header">
          <span class="phase-num">{phase.num}</span>
          <span class="phase-title">{phase.title}</span>
          <span class="phase-meta">{phase.weeks}</span>
        </div>
        <div class="grid">
          {modules
            .filter((m) => phase.ids.includes(m.id))
            .map((m) => <Module module={m} kind="epito" />)}
        </div>
      </section>
    ))}

    <section class="phase-section">
      <div class="phase-header">
        <span class="phase-title">Referencia-tárak</span>
        <span class="phase-meta">amikor új mintára van szükséged</span>
      </div>
      <div class="grid">
        {refs.map((r) => (
          <SimpleCard
            slug={r.slug}
            num={r.num}
            title={r.title}
            summary={r.summary}
            tag={r.tag}
            tagKind={r.tagKind}
            phaseLabel={r.phaseLabel}
          />
        ))}
      </div>
    </section>

    <section class="phase-section">
      <div class="phase-header">
        <span class="phase-title">Bónusz építő-modulok</span>
        <span class="phase-meta">skálázódás</span>
      </div>
      <div class="grid">
        {bonuses.map((b) => (
          <SimpleCard
            slug={b.slug}
            num={b.num}
            title={b.title}
            summary={b.summary}
            tag={b.tag}
            tagKind={b.tagKind}
            phaseLabel={b.phaseLabel}
          />
        ))}
      </div>
    </section>

    <section class="phase-section">
      <div class="phase-header">
        <span class="phase-title">Lezárás</span>
        <span class="phase-meta">befejezés</span>
      </div>
      <div class="grid">
        <SimpleCard
          slug={outro.slug}
          title={outro.title}
          summary={outro.summary}
          tag={outro.tag}
          tagKind={outro.tagKind}
          phaseLabel={outro.phaseLabel}
        />
      </div>
    </section>
  </div>

</Layout>
