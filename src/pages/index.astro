---
import Layout from "../layouts/Layout.astro";
import Module from "../components/Module.astro";
import SimpleCard from "../components/SimpleCard.astro";
import modulesData from "../data/modules.json";
import extraData from "../data/extra-modules.json";

interface ModuleData {
  id: string;
  slug: string;
  phase: string;
  phaseShort: string;
  title: string;
  summary: string;
  result: string;
  lessons: string[];
  promptIntro: string;
  promptText: string;
  caseStudyIds: string[];
}

interface ExtraModule {
  id: string;
  slug: string;
  num?: string;
  title: string;
  summary: string;
  tag: string;
  tagKind: "intro" | "epito" | "bonus";
  phaseLabel: string;
}

const modules: ModuleData[] = modulesData;
const extras: ExtraModule[] = extraData;

const intro = extras.find((e) => e.id === "intro")!;
const outro = extras.find((e) => e.id === "outro")!;
const refs = extras.filter((e) => ["17", "18", "19"].includes(e.id));
const bonuses = extras.filter((e) => ["20", "21", "22", "23"].includes(e.id));

const phases = [
  { num: "I. fázis", title: "Mit adsz el és kinek?", weeks: "1-3. hét", ids: ["01", "02", "03"] },
  { num: "II. fázis", title: "Hogyan találjanak meg?", weeks: "4-6. hét", ids: ["04", "05", "06"] },
  { num: "III. fázis", title: "Hogyan szólítsd meg őket?", weeks: "7-9. hét", ids: ["07", "08", "09"] },
  { num: "IV. fázis", title: "Háttér és számok", weeks: "10-12. hét", ids: ["10", "11", "12"] },
];
---

<Layout
  title="Expert Flow Start — 12 hét, ahogy én építem fel a vállalkozásomat"
  description="Magyar szolgáltató szakértőknek: 12 hét, 12 modul, 12 másolható prompt + 4 bónusz tár. A 12. hét végére van weboldalad, lead magneted, konzultációs funneled, CRM-ed, és egy működő AI Operációs Rendszered."
>

  <header class="hero">
    <div class="eyebrow">12 hét · ahogy én építem fel</div>
    <h1>Expert Flow <em>Start</em></h1>
    <p class="lede">
      Magyar szolgáltató szakértőknek. 12 hét, 4 fázis, 12 építő modul +
      4 bónusz tár — a saját utamon szerzett tapasztalat, magyar nyelven.
      Minden modulhoz másolható Claude Code prompt és élő AI Operációs Rendszer.
    </p>
    <div class="stats">
      <div class="stat"><b>12</b><span>hét</span></div>
      <div class="stat"><b>21</b><span>modul</span></div>
      <div class="stat"><b>4</b><span>fázis</span></div>
      <div class="stat"><b>4</b><span>bónusz</span></div>
    </div>
    <div class="hero-ctas">
      <a class="hero-cta" href="#modulok">
        <span>Modulok megnyitása</span>
        <span class="arrow">→</span>
      </a>
    </div>
  </header>

  <div class="container" id="modulok">
    <section class="phase-section">
      <div class="phase-header">
        <span class="phase-title">Bevezető</span>
        <span class="phase-meta">kezdés</span>
      </div>
      <div class="grid">
        <SimpleCard
          slug={intro.slug}
          title={intro.title}
          summary={intro.summary}
          tag={intro.tag}
          tagKind={intro.tagKind}
          phaseLabel={intro.phaseLabel}
        />
      </div>
    </section>

    {phases.map((phase) => (
      <section class="phase-section">
        <div class="phase-header">
          <span class="phase-num">{phase.num}</span>
          <span class="phase-title">{phase.title}</span>
          <span class="phase-meta">{phase.weeks}</span>
        </div>
        <div class="grid">
          {modules
            .filter((m) => phase.ids.includes(m.id))
            .map((m) => <Module module={m} kind="epito" />)}
        </div>
      </section>
    ))}

    <section class="phase-section">
      <div class="phase-header">
        <span class="phase-title">Referencia-tárak</span>
        <span class="phase-meta">amikor új mintára van szükséged</span>
      </div>
      <div class="grid">
        {refs.map((r) => (
          <SimpleCard
            slug={r.slug}
            num={r.num}
            title={r.title}
            summary={r.summary}
            tag={r.tag}
            tagKind={r.tagKind}
            phaseLabel={r.phaseLabel}
          />
        ))}
      </div>
    </section>

    <section class="phase-section">
      <div class="phase-header">
        <span class="phase-title">Bónusz építő-modulok</span>
        <span class="phase-meta">skálázódás</span>
      </div>
      <div class="grid">
        {bonuses.map((b) => (
          <SimpleCard
            slug={b.slug}
            num={b.num}
            title={b.title}
            summary={b.summary}
            tag={b.tag}
            tagKind={b.tagKind}
            phaseLabel={b.phaseLabel}
          />
        ))}
      </div>
    </section>

    <section class="phase-section">
      <div class="phase-header">
        <span class="phase-title">Lezárás</span>
        <span class="phase-meta">befejezés</span>
      </div>
      <div class="grid">
        <SimpleCard
          slug={outro.slug}
          title={outro.title}
          summary={outro.summary}
          tag={outro.tag}
          tagKind={outro.tagKind}
          phaseLabel={outro.phaseLabel}
        />
      </div>
    </section>
  </div>

</Layout>
