---
import Layout from "../layouts/Layout.astro";
import Module from "../components/Module.astro";
import modulesData from "../data/modules.json";

interface ModuleData {
  id: string;
  slug: string;
  phase: string;
  phaseShort: string;
  title: string;
  summary: string;
  result: string;
  lessons: string[];
  promptIntro: string;
  promptText: string;
  caseStudyIds: string[];
}

const modules: ModuleData[] = modulesData;

const phases = [
  {
    short: "I. fázis",
    weeks: "1–3. hét",
    title: "Mit adsz el és kinek?",
    intro: "A tudásod magja, a vevőd, az ajánlatod. Ez az alap; ha ezek nincsenek tisztán, a többi 9 hét nem működik.",
    moduleIds: ["01", "02", "03"],
  },
  {
    short: "II. fázis",
    weeks: "4–6. hét",
    title: "Hogyan találjanak meg?",
    intro: "Eszközök setup-ja (VS Code + Claude Code + Sybell + Google Workspace), weboldal Vercel-en, copy és landing.",
    moduleIds: ["04", "05", "06"],
  },
  {
    short: "III. fázis",
    weeks: "7–9. hét",
    title: "Hogyan szólítsd meg őket?",
    intro: "Konzultációs funnel (Cal.com), ügyfél-szerzés ismerős-listáról, lead magnet és email lista.",
    moduleIds: ["07", "08", "09"],
  },
  {
    short: "IV. fázis",
    weeks: "10–12. hét",
    title: "Háttér és számok",
    intro: "Google Sheets CRM + Gmail/Drive struktúra, GA4 mérés, jogi és számlázási minimum.",
    moduleIds: ["10", "11", "12"],
  },
];

const faqs = [
  {
    q: "Elég-e a $20-os Claude Pro?",
    a: "Az első 2-3 hónapra általában elég a Claude Pro ($20/hó), mert a setup-modulokon (1-4. hét) még nem dolgozol intenzíven. A 4. modultól kezdve, amikor a Claude Code aktívan ír kódot a webhelyedre, érdemes figyelni a tokenfogyasztást — ha ki akarod tolni, váltani lehet Claude Code Max-ra. Ezt nem kötelező az 1. hétről."
  },
  {
    q: "Mi az a Claude Code és miért nem ChatGPT?",
    a: "A Claude Code egy parancssorba és VS Code-ba épülő AI-asszisztens, ami a fájljaidat látja, kódot ír, fájlokat szerkeszt — nem chat-ablak. A ChatGPT erre nem alkalmas: vagy a Codex/Cursor szintű alternatíva kellene. A Claude Code a leghosszabb kontextust és a legpontosabb hangtartást adja magyar projektekhez — ezért épül erre az egész 12 hét."
  },
  {
    q: "Programozni nem tudok. Akkor is működik?",
    a: "Igen — pontosan azért épül így. Egyetlen sor kódot sem fogsz „írni” — a Claude Code-nak elmondod magyarul, mit szeretnél, és ő generálja a HTML-t, JS-t, scripteket. A te dolgod, hogy értsd, mit akarsz (1-3. modul), és hogy ránézz az output-ra, hogy az-e."
  },
  {
    q: "Mennyi időt igényel hetente?",
    a: "Heti 1 óra videó + 2-4 óra tényleges feladat-elvégzés. Összesen 12 hét alatt 30-50 óra. Ha egy hét kimarad, semmi gond — folytatod ott, ahol abbahagytad. A 12 modul kötött sorrendű, de a tempó a tied."
  },
  {
    q: "Mi az EV-AIOS és mi köze ehhez a kurzushoz?",
    a: "Az EV-AIOS egy ingyenes, MIT-licenszelt sablon GitHub-on, ami a Claude Code-ot a személyes AI Operációs Rendszereddé alakítja. A 12 modul végére neked is lesz egy hasonló: a saját context fájljaiddal, kapcsolatokkal, döntésnaplóval. A modulonkénti promptok egymásra épülnek, és az output-juk az AIOS-be kerül."
  },
  {
    q: "Magyar piacra szabott a tartalom?",
    a: "Igen, a 12. modul kifejezetten magyar (KATA, NAV, Számlázz.hu, ÁSZF), a 8. modul a magyar B2B-ismerős kultúrához igazítva, a 4. modul a Sybell domain-szolgáltatóval. A 38 esettanulmány nemzetközi (mert magyar nyelvű részletes elemzés alig létezik), de mindegyiket magyar piaci szemüvegen át mutatjuk be — nem másolunk, hanem adaptálunk."
  },
];

const outcomes = [
  { t: "Egyoldalas weboldal", d: "Saját domaineden, HTTPS-szel, mobilbarát, Vercel-en hostolva" },
  { t: "Külön landing oldal", d: "Egy konkrét szolgáltatásra, 7-elemes sales-szerkezettel" },
  { t: "Lead magnet PDF + Kit funnel", d: "5-10 oldalas PDF + 5 emailes welcome sorozat automatikusan" },
  { t: "Cal.com konzultációs funnel", d: "Foglalás → 4 automatikus email → no-show kezelés" },
  { t: "Google Sheets CRM", d: "4 munkalap + Apps Script automatizációk + Gmail/Drive struktúra" },
  { t: "GA4 mérőrendszer", d: "Öt esemény + heti dashboard a saját Sheets-edben" },
  { t: "Jogilag rendben", d: "Vállalkozási forma, Számlázz.hu/Billingo, ÁSZF, Adatvédelem" },
  { t: "Saját AI Operációs Rendszer", d: "GitHub-on, EV-AIOS alapra építve, a saját context-eddel" },
];

const bonusItems = [
  { num: "17", title: "Landing page minták", desc: "5 referencia-minta a 6. modulhoz, magyarul kommentelve." },
  { num: "18", title: "Funnel típusok", desc: "4 funnel-architektúra (Capture / Application / Webinar / Tripwire)." },
  { num: "19", title: "AI eszköz-skillek", desc: "6 letölthető Claude Code skill ismétlődő workflow-khoz." },
  { num: "20", title: "Az első digitális terméked", desc: "Ahogy ez a kurzus is készült — videókurzus AI-vágással." },
  { num: "22", title: "Expert Flow tech-stack", desc: "52 szolgáltatás 11 kategóriában: mire használom, mennyibe kerül." },
  { num: "23", title: "38 esettanulmány tár", desc: "A modulokba osztott esetek külön, részletes Drive-anyagokkal." },
];
---

<Layout
  title="Expert Flow Start 2.0 — 12 hét, 12 modul, 12 másolható prompt"
  description="Magyar szolgáltató szakértőknek: 12 hét alatt felépítesz egy működő, IDE-alapú online vállalkozást. Minden modulhoz másolható Claude Code prompt + élő AI Operációs Rendszer."
>

  <header class="hero">
    <div class="eyebrow">12 hét · ahogy én építem fel · v2.0</div>
    <h1>Expert Flow <em>Start</em></h1>
    <p class="lede">
      12 hét, 12 modul, 12 másolható prompt — magyar szolgáltató
      szakértőknek. A 12. hét végére van weboldalad, lead magneted,
      konzultációs funneled, CRM-ed, méréseid — és egy működő, élő AI
      Operációs Rendszered, amit Claude Code-dal építettél fel.
    </p>
    <div class="stats">
      <div class="stat"><b>12</b><span>hét</span></div>
      <div class="stat"><b>12</b><span>prompt</span></div>
      <div class="stat"><b>37</b><span>esettanulmány</span></div>
      <div class="stat"><b>1</b><span>élő AIOS</span></div>
    </div>
    <div class="hero-ctas">
      <a class="hero-cta" href="#modulok">
        <span>Mutasd a 12 modult</span>
        <span class="arrow">→</span>
      </a>
      <a class="hero-cta hero-cta--ghost" href="#hogyan">Hogyan működik?</a>
    </div>
  </header>

  <section class="pull" aria-labelledby="litmusz-heading">
    <div class="pull__inner">
      <span class="eyebrow">A litmusz teszt</span>
      <h2 id="litmusz-heading" class="sr-only">A litmusz teszt</h2>
      <blockquote>
        Miközben nem ülsz a géped előtt, az AIOS-od megfigyel egy valós
        eseményt és kimenetet készít, ami gyorsabb és pontosabb, mint
        amit te magad készítenél.
      </blockquote>
      <cite>Ez a kurzus erre a tesztre épít minden modult.</cite>
    </div>
  </section>

  <section id="hogyan">
    <div class="container container--narrow">
      <div class="section-head">
        <div>
          <span class="eyebrow">Hogyan működik</span>
          <h2>Videót nézel. Promptot másolsz. <em>Az AIOS-od nő.</em></h2>
        </div>
      </div>
      <p class="section-intro">
        Ez a kurzus nem PDF-letöltések gyűjteménye, és nem 8 órás videó-maraton.
        Heti 1 modul, mindegyik három lépésre szétbontva — és minden modul
        végén az IDE-d konkrétabb, mint az előtt volt.
      </p>
      <div class="steps">
        <article class="step">
          <span class="step__num">01 · 5–10 perc</span>
          <h3>Megnézed a modul-videót</h3>
          <p>Rövid, dokumentáló-hangú felmondás arról, mit csinálok én ezen a héten — felmondás, nem prezentáció.</p>
        </article>
        <article class="step">
          <span class="step__num">02 · 1 perc</span>
          <h3>Bemásolod a promptot</h3>
          <p>Egy gombra kattintással átkerül a Claude Code-ba. A prompt a saját kezed nyersanyagát kéri be — nem dönt helyetted.</p>
        </article>
        <article class="step">
          <span class="step__num">03 · 2–4 óra</span>
          <h3>A heti darab a saját AIOS-ben</h3>
          <p>A modul-output (avatár, ajánlat, weboldal-vázlat, prompt) bekerül a saját <code>context/</code> mappádba — ez a következő modul bemenete lesz.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="modulok">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">A 12 modul · 4 fázis</span>
          <h2>Egy hét = egy modul = <em>egy kézzelfogható darab.</em></h2>
        </div>
        <span class="meta">12 héten át · saját tempóban</span>
      </div>
      <p class="section-intro">
        Minden modulnál megnézheted a leckéket, az output-ot, a másolható
        promptot, és a kapcsolódó nemzetközi esettanulmányokat. Kattints
        rá bármelyik modulra a részletekért.
      </p>

      {phases.map((phase) => (
        <section class="phase-section">
          <div class="phase-header">
            <span class="phase-num">{phase.short}</span>
            <span class="phase-title">{phase.title}</span>
            <span class="phase-meta">{phase.weeks}</span>
          </div>
          <p class="phase-intro">{phase.intro}</p>
          <div class="grid">
            {modules
              .filter((m) => phase.moduleIds.includes(m.id))
              .map((m) => <Module module={m} kind="epito" />)}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="outcome" aria-labelledby="outcome-heading">
    <div class="outcome__inner">
      <div class="section-head">
        <div>
          <span class="eyebrow">A 12. hét végén</span>
          <h2 id="outcome-heading">Nem tananyaggal. <em>Egy működő rendszerrel.</em></h2>
        </div>
      </div>
      <ul class="outcome__list">
        {outcomes.map((o) => (
          <li><strong>{o.t}</strong><span>{o.d}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="bonusz">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">A 12 hét után</span>
          <h2>Bónusz tárak — <em>amikor továbblépsz.</em></h2>
        </div>
      </div>
      <div class="bonus__grid">
        <article class="bonus__feature">
          <span class="eyebrow">Központi bónusz</span>
          <h3>Claude Code haladó productivity-trükkök</h3>
          <p>
            Ha a 4. modul Claude Code alapjai már a kezedben vannak, ez a
            20 trükkös tár megmutatja, hogyan használd ki a sub-agenteket,
            a plan mode-ot, az ultrathinket, a Chrome DevTools MCP-t és a
            Context7 MCP-t. Három szinten, magyarul.
          </p>
          <span class="pin">
            <span class="dot" aria-hidden="true"></span>
            Minden hallgatónak jár — nem külön add-on
          </span>
        </article>
        <div class="bonus__list">
          {bonusItems.map((b) => (
            <div class="bonus__item">
              <strong><span class="num">{b.num}.</span> {b.title}</strong>
              <span>{b.desc}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container container--narrow">
      <div class="section-head">
        <div>
          <span class="eyebrow">Mire jó és mire nem</span>
          <h2>A program nem mindenkinek való — <em>és ezt jobb előre tisztázni.</em></h2>
        </div>
      </div>
      <div class="anti__grid">
        <div class="anti__col anti__col--yes">
          <h3>Akkor használd, <em>ha…</em></h3>
          <ul>
            <li>Magyar szolgáltató szakértő vagy (tanácsadó, fotós, coach, könyvelő, ügyvéd, tréner, szövegíró)</li>
            <li>Mellékállásban vagy újrakezdőként indítasz, és nincs még éles online jelenléted</li>
            <li>Hajlandó vagy IDE-ben (VS Code + Claude Code) dolgozni — nem ChatGPT-zel chat-elgetni</li>
            <li>Heti 3–5 órát be tudsz tenni 12 héten át</li>
            <li>Dokumentáló, technikai munkamódot keresel</li>
          </ul>
        </div>
        <div class="anti__col anti__col--no">
          <h3>Ne válaszd, <em>ha…</em></h3>
          <ul>
            <li>Általános AI-tanfolyamot keresel (ChatGPT-prompting, n8n, Zapier-automatizáció)</li>
            <li>E-kereskedelmet, dropshippinget vagy ügynöki üzletágat akarsz indítani</li>
            <li>Gyors meggazdagodást ígérő rendszerre vágysz — itt minden hét munka</li>
            <li>Nem akarsz semmilyen technikai eszközhöz hozzányúlni (még az AI-jal sem)</li>
            <li>Készen vársz tartalmakat, sablonokat copy-paste-re — itt minden a TE válaszaidból épül</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="gyik">
    <div class="container container--narrow">
      <div class="section-head">
        <div>
          <span class="eyebrow">Gyakori kérdések</span>
          <h2>Az első 6 dolog, <em>amit kérdezni szoktak.</em></h2>
        </div>
      </div>
      <div class="faq__list">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-final">
    <span class="eyebrow">Következő lépés</span>
    <h2>Ha végigolvastad, valószínűleg <em>látod, mire való.</em></h2>
    <p>
      Az árazás és a regisztráció még nincs kész. Ha érdekel, jelezd
      emailben — szólok, amikor elindul az első kohorsz, és addig
      elküldöm az EV-AIOS GitHub repo linkjét, hogy közben megnézd,
      miből épül a kurzus alapja.
    </p>
    <a class="hero-cta" href="mailto:hello@expertflow.hu?subject=Expert%20Flow%20Start%202.0%20érdekel">
      <span>Kérek értesítést indulásnál</span>
      <span class="arrow">→</span>
    </a>
    <p class="small">hello@expertflow.hu · Magyarul, dokumentáló hangon, hype nélkül.</p>
  </section>

</Layout>
