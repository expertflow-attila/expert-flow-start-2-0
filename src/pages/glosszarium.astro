---
import Layout from "../layouts/Layout.astro";
import glossary from "../data/glossary.json";

interface GlossaryEntry {
  term: string;
  definition: string;
}

const entries: GlossaryEntry[] = Object.entries(glossary as Record<string, string>)
  .map(([term, definition]) => ({ term, definition }))
  .sort((a, b) => a.term.localeCompare(b.term, "hu"));

const site = (Astro.site ?? new URL("https://expert-flow-start-2-0.vercel.app")).toString();

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "Business Start glosszárium",
    description: "Magyar nyelvű szakkifejezések és angol marketing-szavak fordítása a Business Start kurzushoz.",
    url: `${site}glosszarium`,
    inLanguage: "hu",
    hasDefinedTerm: entries.map((e) => ({
      "@type": "DefinedTerm",
      name: e.term,
      description: e.definition,
      inDefinedTermSet: `${site}glosszarium`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Főoldal", item: site },
      { "@type": "ListItem", position: 2, name: "Glosszárium", item: `${site}glosszarium` },
    ],
  },
];
---

<Layout
  title="Glosszárium — Business Start"
  description="Magyar fordítás és magyarázat azokhoz az angol marketing- és technikai kifejezésekhez, amik a Business Start kurzusban előfordulnak. CTA, KPI, USP, CRM, GA4, funnel, MCP, és társaik."
  schema={schema}
>
  <header class="hero">
    <div class="eyebrow">Szótár · kurzus-segéd</div>
    <h1>Glosszárium</h1>
    <p class="lede">
      Magyar fordítás és magyarázat azokhoz az angol marketing- és technikai
      kifejezésekhez, amik a kurzusban előkerülnek. Ha valami ismeretlenül
      hangzik, először itt nézz utána.
    </p>
  </header>

  <div class="container">
    <section class="phase-section">
      <div class="phase-header">
        <span class="phase-title">{entries.length} kifejezés</span>
        <span class="phase-meta">ábécé-sorrendben</span>
      </div>

      <dl class="glossary-list">
        {entries.map((e) => (
          <div class="glossary-entry" id={`g-${e.term.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
            <dt class="glossary-term">{e.term}</dt>
            <dd class="glossary-def">{e.definition}</dd>
          </div>
        ))}
      </dl>

      <div style="margin-top: 48px; text-align: center;">
        <a href="/" class="back" style="display: inline-flex; align-items: center; gap: 8px;">
          <span class="arr">←</span> Vissza a tartalomjegyzékhez
        </a>
      </div>
    </section>
  </div>

  <style>
    .glossary-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      margin: 24px 0 0;
      padding: 0;
      border-top: 1px solid var(--border-cell);
    }

    .glossary-entry {
      position: relative;
      display: grid;
      grid-template-columns: minmax(140px, 200px) 1fr;
      gap: 20px;
      padding: 22px 24px;
      background: transparent;
      border-bottom: 1px solid var(--border-cell);
      border-radius: 0;
      align-items: baseline;
      transition: background var(--t-fast) var(--ease);
      overflow: hidden;
    }
    .glossary-entry::after {
      content: "";
      position: absolute;
      inset: 4px;
      background: var(--accent);
      opacity: 0;
      pointer-events: none;
      clip-path: inset(0 100% 0 0);
      transition: opacity var(--t-mid) var(--ease), clip-path var(--t-mid) var(--ease);
    }
    .glossary-entry:hover::after { opacity: 0.05; clip-path: inset(0 0 0 0); }
    .glossary-entry > * { position: relative; z-index: 1; }

    .glossary-term {
      font-family: var(--font-mono, "JetBrains Mono", monospace);
      font-size: 13px;
      font-weight: 500;
      color: var(--accent-strong, var(--accent));
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin: 0;
    }

    .glossary-def {
      margin: 0;
      color: var(--text-muted, var(--text));
      line-height: 1.6;
      font-size: 15px;
    }

    @media (max-width: 640px) {
      .glossary-entry {
        grid-template-columns: 1fr;
        gap: 6px;
        padding: 18px 20px;
      }
    }
  </style>
</Layout>
