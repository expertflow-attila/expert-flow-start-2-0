---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const { title, description, schema, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://expert-flow-start-2-0.vercel.app");
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL("/og-image.jpg", site).toString();
const schemaJson = schema
  ? JSON.stringify(Array.isArray(schema) ? schema : schema)
  : null;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0c" />
    <meta name="generator" content={Astro.generator} />
    {noindex
      ? <meta name="robots" content="noindex,follow" />
      : <meta name="robots" content="index,follow,max-image-preview:large" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Business Start" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Business Start — 12 hét, ahogy felépítem a vállalkozásomat" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Business Start — Solo Business" />

    {schemaJson && (
      <script type="application/ld+json" set:html={schemaJson} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <slot name="head" />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Ugrás a tartalomra</a>

    <div class="bg-fx-glow-tl" aria-hidden="true"></div>
    <div class="bg-fx-vignette" aria-hidden="true"></div>
    <div class="bg-fx-grain" aria-hidden="true"></div>

    <main id="main" class="shell" tabindex="-1">

      <header class="site-header">
        <div class="g g-header">
          <a href="/" class="gc gc-link" aria-label="Business Start — főoldal">
            <span class="brand-logo"><b>Business Start</b></span>
          </a>
        </div>

        <div class="mobile-bar">
          <a href="/" class="mobile-bar-brand" aria-label="Főoldal">
            <span class="brand-logo brand-logo--sm"><b>Business Start</b></span>
          </a>
        </div>
      </header>

      <slot />

      <footer class="g g-foot foot">
        <div class="gc">
          <span class="label-sm">Business Start</span>
          <span class="label-sm accent">12 hét</span>
        </div>
        <div class="gc">
          <a href="mailto:hello@expertflow.hu" class="label-sm with-arrow">hello@expertflow.hu</a>
        </div>
        <div class="gc">
          <span class="label-sm dim">© 2026 · Solo Business</span>
          <span class="label-sm dim">Az Expert Flow és a Solo Business is Nagy Attila munkája.</span>
        </div>
      </footer>

    </main>

    <script is:inline>
      (function () {
        const isMobile = window.matchMedia('(max-width: 720px)').matches;
        const FEEDBACK_MS = isMobile ? 2400 : 1800;
        document.querySelectorAll('[data-copy-target]').forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (btn.dataset.copied === 'true') return;
            const sel = btn.getAttribute('data-copy-target');
            if (!sel) return;
            const el = document.querySelector(sel);
            if (!el) return;
            const original = btn.dataset.label || btn.textContent || 'Másol';
            const text = el.textContent || '';
            try {
              if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(text);
              } else {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.setAttribute('readonly', '');
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
              }
              btn.dataset.copied = 'true';
              btn.textContent = '✓ Másolva';
              setTimeout(() => {
                btn.dataset.copied = 'false';
                btn.textContent = original;
              }, FEEDBACK_MS);
            } catch (err) {
              btn.textContent = 'Hiba — másold kézzel';
              setTimeout(() => { btn.textContent = original; }, 2400);
            }
          });
        });
      })();
    </script>
  </body>
</html>
